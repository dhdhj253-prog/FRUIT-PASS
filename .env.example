# ==========================================
# Fruit Pass Telegram Bot Configuration
# ==========================================

# 1. Your Telegram Bot API Token from @BotFather
# Example: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=your_bot_token_here

# 2. Bot Username (including the @ symbol)
BOT_USERNAME=@FruitPassBot

# 3. Path to SQLite database file
DB_PATH=fruit_pass.db

# 4. Cleanup old turn panels & pings (optional: true / false, default: false)
CLEANUP_ENABLED=false
